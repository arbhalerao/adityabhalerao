{
    "trailingSlash": false,
    "rewrites": [
        {
            "source": "/_vercel/insights/(.*)",
            "destination": "/_vercel/insights/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/(sitemap.xml|robots.txt)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        }
    ]
}
