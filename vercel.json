{
    "trailingSlash": false,
    "redirects": [
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": "adityabhalerao.vercel.app"
                }
            ],
            "destination": "https://www.adityabhalerao.com/$1",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/_vercel/insights/(.*)",
            "destination": "/_vercel/insights/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/(sitemap.xml|robots.txt)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        }
    ]
}
